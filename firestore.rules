rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signed() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function teacher() {
      return signed()
        && get(
          /databases/$(database)/documents/users/$(me())
        ).data.role == 'teacher';
    }

    function student() {
      return signed()
        && get(
          /databases/$(database)/documents/users/$(me())
        ).data.role == 'student';
    }

    function cls(id) {
      return get(
        /databases/$(database)/documents/classes/$(id)
      ).data;
    }

    function ownClass(id) {
      return teacher() && cls(id).teacherId == me();
    }

    function statusValid(status) {
      return status in ['approved', 'declined'];
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'name', 'phone', 'grade', 'role'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.matches('0[0-9]{9}')
        && data.grade is int
        && data.grade >= 1
        && data.grade <= 13;
    }

    match /users/{id} {
      allow read: if signed() && id == me();

      allow create: if signed()
        && id == me()
        && validProfile(request.resource.data)
        && request.resource.data.role == 'student';

      allow update: if signed()
        && id == me()
        && validProfile(request.resource.data)
        && request.resource.data.role == resource.data.role;
    }

    match /preferences/{id} {
      allow read: if signed() && id == me();

      allow create, update: if student()
        && id == me()
        && request.resource.data.keys().hasOnly([
          'subject', 'medium', 'budget',
          'latitude', 'longitude', 'radiusKm',
          'day', 'start', 'end', 'needs'
        ])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.medium is string
        && request.resource.data.medium.size() > 0
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radiusKm is number
        && request.resource.data.radiusKm >= 0
        && request.resource.data.radiusKm <= 500
        && request.resource.data.day is int
        && request.resource.data.day >= 0
        && request.resource.data.day <= 6
        && request.resource.data.start is int
        && request.resource.data.start >= 0
        && request.resource.data.end is int
        && request.resource.data.end <= 1439
        && request.resource.data.end >
          request.resource.data.start
        && request.resource.data.needs is string
        && request.resource.data.needs.size() <= 2000;
    }

    function validClass(data) {
      return data.keys().hasOnly([
          'teacherId', 'teacherName', 'title',
          'subject', 'grade', 'medium', 'fee',
          'mode', 'location', 'latitude', 'longitude',
          'day', 'start', 'end', 'capacity',
          'enrolledCount', 'trialDate', 'active',
          'lastEnrollmentId'
        ])
        && data.teacherName is string
        && data.teacherName.size() > 0
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 150
        && data.subject is string
        && data.subject.size() > 0
        && data.medium is string
        && data.medium.size() > 0
        && data.grade is int
        && data.grade >= 1
        && data.grade <= 13
        && data.fee is number
        && data.fee >= 0
        && data.mode in ['online', 'in-person']
        && data.location is string
        && data.location.size() > 0
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.day is int
        && data.day >= 0
        && data.day <= 6
        && data.start is int
        && data.start >= 0
        && data.end is int
        && data.end <= 1439
        && data.end > data.start
        && data.capacity is int
        && data.capacity >= 1
        && data.capacity <= 500
        && data.enrolledCount is int
        && data.enrolledCount >= 0
        && data.capacity >= data.enrolledCount
        && data.trialDate is string
        && data.active is bool;
    }

    function validCountIncrease(classId, data) {
      let enrollmentId = data.lastEnrollmentId;
      let enrollmentPath =
        /databases/$(database)/documents/enrollments/$(enrollmentId);
      let enrollment = getAfter(enrollmentPath).data;

      return resource.data.active
        && data.enrolledCount ==
          resource.data.enrolledCount + 1
        && data.diff(resource.data).affectedKeys().hasOnly([
          'enrolledCount', 'lastEnrollmentId'
        ])
        && !exists(enrollmentPath)
        && enrollment.classId == classId
        && enrollment.teacherId == me();
    }

    match /classes/{id} {
      allow read: if signed();

      allow create: if teacher()
        && request.resource.data.teacherId == me()
        && validClass(request.resource.data)
        && request.resource.data.enrolledCount == 0
        && !('lastEnrollmentId' in request.resource.data)
        && request.resource.data.teacherName ==
          get(
            /databases/$(database)/documents/users/$(me())
          ).data.name;

      allow update: if teacher()
        && resource.data.teacherId == me()
        && validClass(request.resource.data)
        && request.resource.data.teacherId ==
          resource.data.teacherId
        && request.resource.data.teacherName ==
          resource.data.teacherName
        && (
          (
            request.resource.data.enrolledCount ==
              resource.data.enrolledCount
            && !request.resource.data.diff(
              resource.data
            ).affectedKeys().hasAny([
              'lastEnrollmentId'
            ])
          )
          || validCountIncrease(id, request.resource.data)
        );
    }

    function validNewRequest(id, data) {
      let selectedClass = cls(data.classId);

      return student()
        && data.keys().hasOnly([
          'studentId', 'studentName', 'teacherId',
          'classId', 'classTitle', 'kind', 'status',
          'needs', 'sessionDate', 'createdAt'
        ])
        && data.studentId == me()
        && data.studentName ==
          get(
            /databases/$(database)/documents/users/$(me())
          ).data.name
        && data.kind in ['trial', 'enrollment', 'waitlist']
        && id == data.classId + '_' + me() + '_' + data.kind
        && data.teacherId == selectedClass.teacherId
        && data.classTitle == selectedClass.title
        && selectedClass.active
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.needs is string
        && data.needs.size() <= 2000
        && !exists(
          /databases/$(database)/documents/enrollments/$(data.classId + '_' + me())
        )
        && (
          data.kind == 'waitlist'
          || selectedClass.enrolledCount <
            selectedClass.capacity
        )
        && (
          data.kind == 'trial'
            ? data.sessionDate == selectedClass.trialDate
              && selectedClass.trialDate.size() > 0
            : data.sessionDate == ''
        );
    }

    function validReview(id, data) {
      let enrollmentId =
        resource.data.classId + '_' + resource.data.studentId;
      let enrollmentPath =
        /databases/$(database)/documents/enrollments/$(enrollmentId);

      return ownClass(resource.data.classId)
        && resource.data.teacherId == me()
        && resource.data.status == 'pending'
        && statusValid(data.status)
        && data.reviewedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt'
        ])
        && (
          data.status == 'declined'
          || resource.data.kind == 'trial'
          || (
            resource.data.kind == 'enrollment'
            && !exists(enrollmentPath)
            && getAfter(enrollmentPath).data.classId ==
              resource.data.classId
            && getAfter(enrollmentPath).data.studentId ==
              resource.data.studentId
          )
        );
    }

    match /requests/{id} {
      allow get: if signed()
        && (
          !exists(
            /databases/$(database)/documents/requests/$(id)
          )
          || resource.data.studentId == me()
          || resource.data.teacherId == me()
        );

      allow list: if signed()
        && (
          resource.data.studentId == me()
          || resource.data.teacherId == me()
        );

      allow create: if signed()
        && validNewRequest(id, request.resource.data);

      allow update: if signed()
        && validReview(id, request.resource.data);
    }

    function validEnrollment(id, data) {
      let classPath =
        /databases/$(database)/documents/classes/$(data.classId);
      let before = get(classPath).data;
      let after = getAfter(classPath).data;

      let requestId =
        data.classId + '_' + data.studentId + '_enrollment';
      let requestPath =
        /databases/$(database)/documents/requests/$(requestId);
      let enrollmentRequest = get(requestPath).data;

      return ownClass(data.classId)
        && data.keys().hasOnly([
          'studentId', 'studentName', 'classId',
          'teacherId', 'classTitle', 'joinedAt'
        ])
        && id == data.classId + '_' + data.studentId
        && data.teacherId == me()
        && data.classTitle == before.title
        && data.joinedAt == request.time
        && before.active
        && before.enrolledCount < before.capacity
        && after.enrolledCount == before.enrolledCount + 1
        && after.lastEnrollmentId == id
        && enrollmentRequest.status == 'pending'
        && enrollmentRequest.kind == 'enrollment'
        && enrollmentRequest.studentId == data.studentId
        && enrollmentRequest.studentName == data.studentName
        && getAfter(requestPath).data.status == 'approved';
    }

    match /enrollments/{id} {
      allow get: if signed()
        && (
          !exists(
            /databases/$(database)/documents/enrollments/$(id)
          )
          || resource.data.studentId == me()
          || resource.data.teacherId == me()
        );

      allow list: if signed()
        && (
          resource.data.studentId == me()
          || resource.data.teacherId == me()
        );

      allow create: if signed()
        && validEnrollment(id, request.resource.data);
    }

    function validNotice(id, data) {
      let requestPath =
        /databases/$(database)/documents/requests/$(id);
      let before = get(requestPath).data;
      let after = getAfter(requestPath).data;

      return ownClass(data.classId)
        && data.keys().hasOnly([
          'userId', 'teacherId', 'classId',
          'requestId', 'message', 'read', 'createdAt'
        ])
        && data.teacherId == me()
        && data.requestId == id
        && data.classId == before.classId
        && data.userId == before.studentId
        && before.status == 'pending'
        && statusValid(after.status)
        && data.read == false
        && data.createdAt == request.time
        && data.message ==
          before.classTitle + ': ' + before.kind
          + ' request ' + after.status + '.';
    }

    match /notifications/{id} {
      allow read: if signed()
        && resource.data.userId == me();

      allow create: if signed()
        && validNotice(id, request.resource.data);

      allow update: if signed()
        && resource.data.userId == me()
        && request.resource.data.read == true
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly(['read']);
    }
  }
}